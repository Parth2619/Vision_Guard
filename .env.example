# Copy to .env and fill in locally. NEVER commit .env.
# No real values here — placeholders only.

APP_ENV=development
LOG_LEVEL=INFO

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# Paths (local only — do NOT commit dataset contents)
RADGENOME_DATA_DIR=./datasets/radgenome_sample
ARTIFACTS_DIR=./artifacts

# LLM provider keys (optional, used in later phases).
# Leave empty here. Do not hard-code real keys anywhere in the repo.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
